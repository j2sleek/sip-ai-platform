# SIP AI Platform - Unified Environment Configuration
# Copy this to .env in respective service dirs or source together.
# All defaults use mock providers - add API keys only if you want real cloud providers.

# ========================================
# LLM Service (apps/voice_core -> http to llm)
# ========================================
LLM_HOST=127.0.0.1
LLM_PORT=5002
LLM_PROVIDER=mock
LLM_MODEL=mock-1
LLM_REQUEST_TIMEOUT_S=30
LLM_MAX_CONCURRENT=4

# Cloud LLM keys (free tiers)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Recommended current free models
# OpenRouter: openai/gpt-oss-20b:free, qwen/qwen3-14b:free, google/gemma-4-26b-a4b-it:free
# Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, qwen/qwen3-32b
# Gemini: gemini-2.5-flash-lite

# ========================================
# STT Service
# ========================================
STT_HOST=127.0.0.1
STT_PORT=5001
STT_PROVIDER=mock
STT_MOCK_TEXT=reference transcript for testing
STT_COMMAND=
STT_COMMAND_TIMEOUT_S=30

# STT Cloud
STT_GROQ_MODEL=whisper-large-v3-turbo
STT_OPENROUTER_MODEL=openai/whisper-large-v3-turbo
STT_GEMINI_MODEL=gemini-2.5-flash

# ========================================
# TTS Service
# ========================================
TTS_HOST=127.0.0.1
TTS_PORT=5003
TTS_PROVIDER=mock
TTS_SAMPLE_RATE=8000
TTS_COMMAND=
TTS_COMMAND_TIMEOUT_S=15
TTS_MAX_CONCURRENT=4
TTS_MAX_TEXT_CHARS=4000

# TTS Cloud
TTS_GROQ_MODEL=openai/tts-1
TTS_GROQ_VOICE=alloy
TTS_OPENROUTER_MODEL=openai/tts-1
TTS_OPENROUTER_VOICE=alloy
TTS_CARTESIA_MODEL=sonic-2
TTS_CARTESIA_VOICE=alloy

# ========================================
# VAD Service
# ========================================
VAD_HOST=127.0.0.1
VAD_PORT=5004
VAD_MAX_CONCURRENT=8
VAD_SILENCE_THRESHOLD=0.015
VAD_MIN_SPEECH_MS=250
VAD_MAX_SPEECH_MS=15000
VAD_SILENCE_MS=700

# ========================================
# Control API / Telephony
# ========================================
CONTROL_API_PORT=4001
CONTROL_API_HOST=127.0.0.1
CONTROL_API_BEARER_TOKEN=
TELEPHONY_MCP_STDIN=1

# Outbound backend: simulated | ari
CALLS_BACKEND=simulated
