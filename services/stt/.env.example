# stt service configuration (copy to .env; real .env files are git-ignored).
# All values have safe development defaults.

STT_HOST=127.0.0.1
STT_PORT=5001
LOG_LEVEL=info

# Provider: groq (production)
STT_PROVIDER=groq
GROQ_API_KEY=
STT_GROQ_MODEL=whisper-large-v3-turbo
STT_GROQ_TIMEOUT_S=30

# Global timeout override (optional)
STT_TIMEOUT_S=

# Limits
STT_MAX_CONCURRENT=8
MAX_BODY_BYTES=16777216