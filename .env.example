# SIP AI Platform — example environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit `.env` or real secrets.
# All values here are placeholders. Secrets belong in a real secret manager for
# production (see AGENTS.md → Security).

# ─── General ────────────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=info

# ─── Asterisk / ARI ───────────────────────────────────────────────────────────
# ARI is the primary call-control interface used by the Elixir core.
ASTERISK_HOST=127.0.0.1
ARI_PORT=8088
# Base URL without a trailing /ari (both voice_core and control_api normalize it).
ARI_BASE_URL=http://127.0.0.1:8088
ARI_USERNAME=voice_core
ARI_PASSWORD=CHANGE_ME
ARI_APP_NAME=voice_core
ARI_WS_URL=ws://127.0.0.1:8088/ari/events
# Caller ID shown on the callee's phone for outbound calls. Without this, ARI
# leaves the channel caller ID empty and the callee sees "Anonymous".
ARI_CALLER_ID='"AI Assistant" <2000>'

# ─── Media transport ──────────────────────────────────────────────────────────
# One of: audiosocket | websocket | rtp   (see docs/DECISIONS.md ADR-0003)
MEDIA_TRANSPORT=audiosocket
# AudioSocket TCP server (Elixir side) — 16-bit PCM, mono, 8 kHz by default.
AUDIOSOCKET_BIND_HOST=127.0.0.1
AUDIOSOCKET_BIND_PORT=9000
# WebSocket media (chan_websocket target; used once verified).
WEBSOCKET_MEDIA_URL=ws://127.0.0.1:8089/media

# ─── Elixir Control API ───────────────────────────────────────────────────────
# control_api HTTP listener. HOST/PORT are the canonical variables it reads.
HOST=127.0.0.1
PORT=4001
CONTROL_API_TOKEN=CHANGE_ME

# ─── Python AI services (internal-only; never expose publicly) ─────────────────
STT_URL=http://127.0.0.1:5001
LLM_URL=http://127.0.0.1:5002
TTS_URL=http://127.0.0.1:5003
VAD_URL=http://127.0.0.1:5004
# Request timeouts in milliseconds — every external call must have a timeout.
STT_TIMEOUT_MS=15000
LLM_TIMEOUT_MS=30000
TTS_TIMEOUT_MS=15000
VAD_TIMEOUT_MS=5000
# The STT/LLM/TTS services reuse keep-alive connections for their outbound
# provider calls instead of paying a DNS + TCP + TLS handshake per request
# (~0.3-0.4 s on a mobile uplink). Set HTTP_KEEPALIVE=0 to disable; HTTP_MAX_IDLE
# bounds the idle connection pool kept per provider origin.
HTTP_KEEPALIVE=1
HTTP_MAX_IDLE=8

# ─── Telephony MCP server (OpenCode brain → call control) ──────────────────────
# The MCP server drives control_api; see apps/telephony_mcp/README.md.
CONTROL_API_URL=http://127.0.0.1:4001
# Call backend used by control_api: ari (Asterisk) | simulated (no telephony)
CALL_BACKEND=ari

# ─── Voice brain (what to say) + turn-taking ───────────────────────────────────
# llm      → the body answers with the local `llm` service (default)
# external → the body only transcribes + reports; OpenCode answers via the
#            telephony MCP `speak` tool (requires CONTROL_API_ENABLED=true)
# static   → canned replies (offline tests/demos)
VOICE_BRAIN=llm
# Report turns to control_api and obey `agent.speak` instructions from it.
CONTROL_API_ENABLED=true
# Spoken when a call attaches without a brain-supplied greeting.
AGENT_GREETING=Hello, this is the AI assistant. How can I help you?
# Trailing silence (ms) before an utterance is endpointed. Raise (~900-1000) if
# the agent cuts you off mid-sentence; lower for brisker turn-taking.
VAD_SILENCE_MS=700
# Hard cap on spoken reply length. Bounds TTS synthesis + playback time, which is
# the dominant per-turn latency for cloud TTS.
AGENT_MAX_REPLY_CHARS=320

# ─── LLM provider (local-first) ────────────────────────────────────────────────
# Default to a local Ollama endpoint; keep behind a provider interface.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:1.5b
# Voice-oriented output budget: long, essay-like replies cause growing per-turn
# latency. Groq reasoning models also need `LLM_REASONING_EFFORT` so the visible
# content is not truncated to an empty string.
LLM_MAX_TOKENS=320
LLM_REASONING_EFFORT=low

# ─── STT / TTS models (small, CPU/ARM-friendly for this host) ──────────────────
WHISPER_MODEL=base
PIPER_VOICE=en_US-lessac-medium

# ─── Node.js services (ChartCapture) ───────────────────────────────────────────
CHARTCAPTURE_API_URL=http://127.0.0.1:3000

# ─── n8n integration ────────────────────────────────────────────────────────────
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=CHANGE_ME

# ─── Persistence (Supabase / PostgreSQL) ────────────────────────────────────────
DATABASE_URL=postgresql://user:CHANGE_ME@127.0.0.1:5432/sip_ai_platform
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
