# tts service configuration (copy to .env; real .env files are git-ignored).
# All values have safe development defaults.

TTS_HOST=127.0.0.1
TTS_PORT=5003
LOG_LEVEL=info

# Provider: groq (production)
TTS_PROVIDER=groq
TTS_SAMPLE_RATE=8000
GROQ_API_KEY=
TTS_GROQ_MODEL=openai/tts-1
TTS_GROQ_VOICE=alloy
TTS_GROQ_TIMEOUT_S=15
TTS_MAX_CONCURRENT=4
TTS_MAX_TEXT_CHARS=4000
MAX_BODY_BYTES=1048576
