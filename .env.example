# SIP AI Platform — example environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit `.env` or real secrets.
# All values here are placeholders. Secrets belong in a real secret manager for
# production (see AGENTS.md → Security).

# ─── General ────────────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=info

# ─── Asterisk / ARI ───────────────────────────────────────────────────────────
# ARI is the primary call-control interface used by the Elixir core.
ASTERISK_HOST=127.0.0.1
ARI_PORT=8088
ARI_BASE_URL=http://127.0.0.1:8088/ari
ARI_USERNAME=CHANGE_ME
ARI_PASSWORD=CHANGE_ME
ARI_APP_NAME=sip_ai_platform
ARI_WS_URL=ws://127.0.0.1:8088/ari/events

# ─── Media transport ──────────────────────────────────────────────────────────
# One of: audiosocket | websocket | rtp   (see docs/DECISIONS.md ADR-0003)
MEDIA_TRANSPORT=audiosocket
# AudioSocket TCP server (Elixir side) — 16-bit PCM, mono, 8 kHz by default.
AUDIOSOCKET_BIND_HOST=127.0.0.1
AUDIOSOCKET_BIND_PORT=9000
# WebSocket media (chan_websocket target; used once verified).
WEBSOCKET_MEDIA_URL=ws://127.0.0.1:8089/media

# ─── Elixir Control API ───────────────────────────────────────────────────────
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=4000
CONTROL_API_TOKEN=CHANGE_ME

# ─── Python AI services (internal-only; never expose publicly) ─────────────────
STT_URL=http://127.0.0.1:5001
LLM_URL=http://127.0.0.1:5002
TTS_URL=http://127.0.0.1:5003
# Request timeouts in milliseconds — every external call must have a timeout.
STT_TIMEOUT_MS=15000
LLM_TIMEOUT_MS=30000
TTS_TIMEOUT_MS=15000

# ─── LLM provider (local-first) ────────────────────────────────────────────────
# Default to a local Ollama endpoint; keep behind a provider interface.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:1.5b

# ─── STT / TTS models (small, CPU/ARM-friendly for this host) ──────────────────
WHISPER_MODEL=base
PIPER_VOICE=en_US-lessac-medium

# ─── Node.js services (ChartCapture) ───────────────────────────────────────────
CHARTCAPTURE_API_URL=http://127.0.0.1:3000

# ─── n8n integration ────────────────────────────────────────────────────────────
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=CHANGE_ME

# ─── Persistence (Supabase / PostgreSQL) ────────────────────────────────────────
DATABASE_URL=postgresql://user:CHANGE_ME@127.0.0.1:5432/sip_ai_platform
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
