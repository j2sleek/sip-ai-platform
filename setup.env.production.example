# SIP AI Platform - Production Configuration (Groq)
# Copy to appropriate .env files for each service

# ========================================
# LLM Service
# ========================================
LLM_HOST=127.0.0.1
LLM_PORT=5002
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
LLM_REQUEST_TIMEOUT_S=30
LLM_MAX_CONCURRENT=4

# ========================================
# STT Service
# ========================================
STT_HOST=127.0.0.1
STT_PORT=5001
STT_PROVIDER=groq
GROQ_API_KEY=
STT_GROQ_MODEL=whisper-large-v3-turbo
STT_GROQ_TIMEOUT_S=30

# ========================================
# TTS Service
# ========================================
TTS_HOST=127.0.0.1
TTS_PORT=5003
TTS_PROVIDER=groq
GROQ_API_KEY=
TTS_GROQ_MODEL=openai/tts-1
TTS_GROQ_VOICE=alloy
TTS_SAMPLE_RATE=8000
TTS_GROQ_TIMEOUT_S=15
TTS_MAX_CONCURRENT=4
TTS_MAX_TEXT_CHARS=4000

# ========================================
# VAD Service
# ========================================
VAD_HOST=127.0.0.1
VAD_PORT=5004
VAD_MAX_CONCURRENT=8
VAD_SILENCE_THRESHOLD=0.015
VAD_MIN_SPEECH_MS=250
VAD_MAX_SPEECH_MS=15000
VAD_SILENCE_MS=700

# ========================================
# Control API
# ========================================
CONTROL_API_PORT=4001
CONTROL_API_HOST=127.0.0.1
PORT=4001
HOST=127.0.0.1
CALLS_BACKEND=ari
CONTROL_API_TOKEN=
ARI_BASE_URL=http://127.0.0.1:8088
ARI_USERNAME=voice_core
ARI_PASSWORD=your-password
ARI_APP=voice_core
ARI_ENDPOINT_TEMPLATE=PJSIP/{to}
