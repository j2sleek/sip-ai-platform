# llm service configuration (copy to .env; real .env files are git-ignored).
# All values have safe development defaults.

LLM_HOST=127.0.0.1
LLM_PORT=5002
LOG_LEVEL=info

# Provider: groq (production)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Request settings
LLM_REQUEST_TIMEOUT_S=30

# Limits
LLM_MAX_CONCURRENT=4
MAX_BODY_BYTES=4194304
