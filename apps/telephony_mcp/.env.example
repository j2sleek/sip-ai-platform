# telephony_mcp — example environment configuration
# Copy to `.env` and adjust. NEVER commit `.env` or real secrets.

# control_api base URL (the call control surface this server drives).
CONTROL_API_URL=http://127.0.0.1:4000

# Optional bearer token for control_api. Must match CONTROL_API_TOKEN there.
CONTROL_API_TOKEN=

# Per-request timeout for control_api calls, in ms.
REQUEST_TIMEOUT_MS=15000

# wait_for_input long-poll budget (default) and hard cap, in ms.
DEFAULT_WAIT_MS=25000
MAX_WAIT_MS=30000
