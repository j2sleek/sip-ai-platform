{
  "name": "telephony_mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Telephony MCP server: exposes call control to an AI brain (e.g. OpenCode) over MCP stdio",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "telephony-mcp": "dist/server.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "demo": "npm run build && node scripts/demo-voice-loop.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
