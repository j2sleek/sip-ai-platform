# control_api — example environment configuration
# Copy to `.env` and adjust. NEVER commit `.env` or real secrets.

# Application environment: development | test | prod
APP_ENV=development

# HTTP bind
HOST=0.0.0.0
PORT=4000

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Optional bearer token guarding /api/v1/*. Empty = auth disabled (local dev).
CONTROL_API_TOKEN=

# Call control backend: simulated (default, no telephony) | ari (Asterisk ARI)
CALL_BACKEND=simulated

# ─── Asterisk ARI (used when CALL_BACKEND=ari) ───────────────────────────────
# Either form is accepted: http://127.0.0.1:8088 or http://127.0.0.1:8088/ari
ARI_BASE_URL=http://127.0.0.1:8088
ARI_USERNAME=voice_core
ARI_PASSWORD=
ARI_APP=voice_core
ARI_TIMEOUT_MS=10000
# {to} is replaced with the requested destination, e.g. PJSIP/{to}
ARI_ENDPOINT_TEMPLATE=PJSIP/{to}

# Long-poll + event-log limits
MAX_EVENT_WAIT_MS=30000
MAX_EVENTS_PER_CALL=1000
